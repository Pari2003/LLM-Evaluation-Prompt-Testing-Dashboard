# ─── Ollama Configuration ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
TEXT_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120.0
LLM_MAX_RETRIES=3

# ─── Evaluation Weights ──────────────────────────────────────────────
# Composite score = weighted average of these dimensions
WEIGHT_LATENCY=0.15
WEIGHT_TOKEN_EFFICIENCY=0.10
WEIGHT_SEMANTIC_QUALITY=0.35
WEIGHT_HALLUCINATION=0.25
WEIGHT_CONSISTENCY=0.15

# ─── Evaluation Thresholds ───────────────────────────────────────────
HALLUCINATION_SIM_THRESHOLD=0.65
CONSISTENCY_SIM_THRESHOLD=0.85

# ─── Experiment Defaults ─────────────────────────────────────────────
DEFAULT_REPETITIONS=3
MAX_CONCURRENT_RUNS=4
RUN_TIMEOUT_SECONDS=120

# ─── Storage ─────────────────────────────────────────────────────────
SQLITE_PATH=./data/eval_db.sqlite

# ─── API Server ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# ─── Embedding ───────────────────────────────────────────────────────
EMBEDDING_DIM=768
